#!/bin/bash

set -eu

# s3simple is a small, simple bash s3 client with minimal dependencies.
# See http://github.com/paulhammond/s3simple for documentation and licence.

_s3simple_hex() {
	od -A n -t x1 | tr -d ' \n\t'
}

_s3simple_hmac_hex() {
	local hexkey="$1"
	local data="$2"
	echo -n "$data" | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$hexkey" -binary | _s3simple_hex
}

# Display usage information
usage() {
	cat << EOF
Usage: s3simple <command> <s3://bucket/key> [file]

Commands:
  get  Download an object from S3
  put  Upload a file to S3
  ls   List objects in a bucket/prefix
  ll   List objects with details (size, date, storage class)
  head Get metadata for an object

Environment Variables:
  AWS_ACCESS_KEY_ID      - AWS access key (required)
  AWS_SECRET_ACCESS_KEY  - AWS secret key (required)
  AWS_DEFAULT_REGION     - AWS region (default: us-east-1)
  AWS_REGION             - Alternative region setting
  AWS_SESSION_TOKEN      - Temporary session token (optional)
  S3_ENDPOINT_URL        - Custom S3 endpoint (optional, for S3-compatible services)

Examples:
  s3simple get s3://bucket/file.txt file.txt
  s3simple put s3://bucket/file.txt file.txt
  s3simple ls s3://bucket/
  s3simple ll s3://bucket/prefix/
EOF
}

# Resolve host, canonical URI, and full URL for the request.
# Sets caller variables: host, canonical_uri, url
_s3simple_resolve_url() {
	local bucket="$1" key="$2" listing="$3" qs="$4" region="$5"

	local base sep
	if [ -n "${S3_ENDPOINT_URL-}" ]; then
		local endpoint="${S3_ENDPOINT_URL%/}"
		host="${endpoint#*://}"
		host="${host%%/*}"
		base="${endpoint}/${bucket}"
		canonical_uri="/${bucket}"
		sep="?"
	elif [[ "$bucket" == *.* ]]; then
		# Bucket names with dots use path-style (wildcard TLS cert doesn't
		# cover multi-label names like a.b.s3.amazonaws.com)
		host="s3.${region}.amazonaws.com"
		base="https://${host}/${bucket}"
		canonical_uri="/${bucket}"
		sep="?"
	else
		host="${bucket}.s3.amazonaws.com"
		base="https://${host}"
		canonical_uri="/"
		sep="/?"
	fi

	if [ -n "$listing" ]; then
		url="${base}${sep}${qs}"
	else
		url="${base}/${key}"
		canonical_uri="${canonical_uri%/}/${key}"
	fi
}

# Compute AWS SigV4 authorization header.
# Sets caller variables: authorization, signed_headers
_s3simple_sign() {
	local method="$1" canonical_uri="$2" canonical_querystring="$3"
	local host="$4" content_sha256="$5" region="$6" amz_date="$7"
	local short_date="${amz_date:0:8}"

	# Step 1: Build canonical headers
	local canonical_headers
	canonical_headers="host:${host}\nx-amz-content-sha256:${content_sha256}\nx-amz-date:${amz_date}"
	signed_headers="host;x-amz-content-sha256;x-amz-date"
	if [ -n "${AWS_SESSION_TOKEN-}" ]; then
		canonical_headers="${canonical_headers}\nx-amz-security-token:${AWS_SESSION_TOKEN}"
		signed_headers="${signed_headers};x-amz-security-token"
	fi

	# Step 2: Build canonical request and hash it
	local canonical_request
	printf -v canonical_request "%s\n%s\n%s\n%b\n\n%s\n%s" \
		"$method" \
		"$canonical_uri" \
		"$canonical_querystring" \
		"$canonical_headers" \
		"$signed_headers" \
		"$content_sha256"

	local canonical_request_hash
	canonical_request_hash=$(echo -n "$canonical_request" | openssl dgst -sha256 | sed 's/^.*= //')

	# Step 3: Build string to sign
	local credential_scope="${short_date}/${region}/s3/aws4_request"

	local string_to_sign
	printf -v string_to_sign "AWS4-HMAC-SHA256\n%s\n%s\n%s" \
		"$amz_date" \
		"$credential_scope" \
		"$canonical_request_hash"

	# Step 4: Derive signing key and compute signature
	local kDate kRegion kService kSigning
	kDate=$(echo -n "$short_date" | openssl dgst -sha256 -hmac "AWS4${AWS_SECRET_ACCESS_KEY}" -binary | _s3simple_hex)
	kRegion=$(_s3simple_hmac_hex "$kDate" "$region")
	kService=$(_s3simple_hmac_hex "$kRegion" "s3")
	kSigning=$(_s3simple_hmac_hex "$kService" "aws4_request")

	local signature
	signature=$(echo -n "$string_to_sign" | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$kSigning" | sed 's/^.*= //')

	authorization="AWS4-HMAC-SHA256 Credential=${AWS_ACCESS_KEY_ID}/${credential_scope}, SignedHeaders=${signed_headers}, Signature=${signature}"
}

s3simple() {
	if [ $# -lt 2 ]; then
		echo "Error: Missing required arguments" >&2
		usage >&2
		return 1
	fi

	local command="$1"
	local url="$2"
	local file="${3:-}"

	# Validate inputs
	if [ "${url:0:5}" != "s3://" ]; then
		echo "Parameter 2 must be an s3 url, e.g. s3://bucket/filename.ext"
		return 1
	fi
	local path="${url:5}"

	if [ -z "${AWS_ACCESS_KEY_ID-}" ]; then
		echo "Need AWS_ACCESS_KEY_ID to be set"
		return 1
	fi

	if [ -z "${AWS_SECRET_ACCESS_KEY-}" ]; then
		echo "Need AWS_SECRET_ACCESS_KEY to be set"
		return 1
	fi

	local region="${AWS_DEFAULT_REGION:-${AWS_REGION:-us-east-1}}"

	# Parse command into HTTP method and curl args
	local method md5 args
	local listing=""
	case "$command" in
	get)
		method="GET"
		md5=""
		file="${file:-$(basename "$path")}"
		args=(-o "$file")
		;;
	head)
		method="HEAD"
		md5=""
		args=(-I)
		;;
	put)
		method="PUT"
		file="${file:-$(basename "$path")}"
		if [ ! -f "$file" ]; then
			echo "file not found: $file"
			exit 1
		fi
		md5="$(openssl md5 -binary "$file" | openssl base64)"
		args=(-T "$file" -H "Content-MD5: $md5")
		;;
	ls | ll)
		method="GET"
		md5=""
		args=()
		listing=1
		;;
	*)
		echo "Error: Unsupported command: $command" >&2
		echo "" >&2
		#echo "Use 's3simple --help' for usage information" >&2
		usage >&2
		return 1
		;;
	esac

	# Parse bucket and key from s3:// path
	local bucket key
	local canonical_querystring=""
	if [ -n "$listing" ]; then
		if [[ "$path" == */* ]]; then
			bucket="${path%%/*}"
			canonical_querystring="list-type=2&prefix=${path#*/}"
		else
			bucket="$path"
			canonical_querystring="list-type=2"
		fi
		key=""
	else
		bucket="${path%%/*}"
		key="${path#*/}"
	fi

	# Resolve host, URL, and canonical URI for the addressing style
	local host canonical_uri
	_s3simple_resolve_url "$bucket" "$key" "$listing" "$canonical_querystring" "$region"

	# Sign the request (AWS SigV4)
	local amz_date
	amz_date="$(date -u '+%Y%m%dT%H%M%SZ')"
	local content_sha256="UNSIGNED-PAYLOAD"
	local authorization signed_headers
	_s3simple_sign "$method" "$canonical_uri" "$canonical_querystring" \
		"$host" "$content_sha256" "$region" "$amz_date"

	# Build curl headers
	args+=(
		-H "Host: ${host}"
		-H "x-amz-date: ${amz_date}"
		-H "x-amz-content-sha256: ${content_sha256}"
		-H "Authorization: ${authorization}"
	)

	if [ -n "${AWS_SESSION_TOKEN-}" ]; then
		args+=(-H "x-amz-security-token: ${AWS_SESSION_TOKEN}")
	fi

	# Execute the request
	if [ "$command" = "ll" ]; then
		# Parse ListObjectsV2 XML into human-readable columns
		curl "${args[@]}" -sS -f "$url" | tr '<' '\n' | awk '
			function human(b) {
				if (b >= 1073741824) return sprintf("%.1f G", b/1073741824)
				if (b >= 1048576)    return sprintf("%.1f M", b/1048576)
				if (b >= 1024)       return sprintf("%.1f K", b/1024)
				return b "  "
			}
			/^Key>/          { gsub(/^Key>/, ""); key=$0 }
			/^LastModified>/ { gsub(/^LastModified>/, ""); mod=$0 }
			/^Size>/         { gsub(/^Size>/, ""); size=$0 }
			/^StorageClass>/ { gsub(/^StorageClass>/, ""); sc=$0 }
			/^\/Contents>/   { total+=size+0; count++; printf "%s  %6s  %-12s  %s\n", mod, human(size+0), sc, key }
			END              { if (count) printf "  %d files, %s total\n", "", count, human(total) }
		'
	elif [ "$command" = "ls" ]; then
		curl "${args[@]}" -sS -f "$url" | grep -o '<Key>[^<]*</Key>' | sed 's/<[^>]*>//g'
	elif [ "$command" = "head" ]; then
		curl "${args[@]}" -sS -f "$url"
	else
		curl "${args[@]}" -f "$url"
	fi
}

if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
	usage
	exit 0
fi

s3simple "$@"
